---
import { ArrowRight } from "@lucide/astro"
import { ROUTES } from "raon:consts"
import { getPosts } from "raon:content"
import { getLangFromUrl, useTranslatedPath, useTranslations } from "raon:i18n"
import PostCard from "./PostCard.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

const posts = await getPosts({ lang, limit: 3 })
---

<section class="flex flex-col gap-4">
  <div class="flex w-full items-center justify-between px-2">
    <div class="flex items-center">
      <h2 class="text-on-surface font-heading text-2xl font-bold">
        {t("components.recentPosts.title")}
      </h2>
    </div>
    <a
      href={translatePath(ROUTES.posts)}
      class="text-brand hover:text-on-surface flex cursor-pointer items-center gap-1 text-sm font-semibold transition-colors"
    >
      {t("common.actions.viewMore")}
      <ArrowRight class="size-4" />
    </a>
  </div>

  {
    posts.length > 0 ? (
      <div class="grid grid-cols-1 gap-6">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <div class="island flex flex-col items-center justify-center gap-4 p-12 text-center">
        <p class="text-on-surface-variant">{t("pages.posts.empty")}</p>
      </div>
    )
  }
</section>
