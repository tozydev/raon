---
import { Sun, Moon, SunMoon, Menu, X } from "@lucide/astro"
import { getLangFromUrl, useTranslatedPath, useTranslations } from "raon:i18n"
import NavLinks from "./NavLinks.astro"
import { ROUTES } from "raon:consts"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<div
  id="header-container"
  data-lang={lang}
  transition:persist
  transition:name="site-header"
  class="sticky top-4 z-50 w-full transition-transform duration-300"
>
  <header class="island glass flex w-full items-center justify-between px-6 py-4">
    <div class="font-heading flex items-center md:w-1/4">
      <a
        href={translatePath(ROUTES.home)}
        class="text-on-surface flex items-center text-xl font-bold tracking-tight transition-colors"
      >
        <span class="text-brand">tozy</span>dev
      </a>
    </div>

    <NavLinks class="hidden grow items-center justify-center gap-4 md:flex" />

    <div class="flex items-center justify-end gap-1 md:w-1/4">
      <!-- <button
        class="btn btn-square hover:text-brand btn-ghost btn-sm [&_svg]:size-4"
        aria-label={t("common.aria.search")}
      >
        <Search />
      </button> -->

      <button
        id="theme-toggle"
        class="btn btn-square btn-ghost btn-sm hover:text-brand relative [&_svg]:size-4"
        aria-label={t("common.aria.themeSwitcher")}
      >
        <span class="theme-icon-auto icon-swap"><SunMoon /></span>
        <span class="theme-icon-light icon-swap"><Sun /></span>
        <span class="theme-icon-dark icon-swap"><Moon /></span>
      </button>

      <button
        id="menu-toggle"
        class="btn btn-square btn-ghost btn-sm hover:text-brand relative md:hidden [&_svg]:size-4"
        aria-label={t("common.aria.toggleMenu")}
      >
        <span class="menu-icon-open icon-swap"><Menu /></span>
        <span class="menu-icon-close icon-swap"><X /></span>
      </button>
    </div>
  </header>

  <NavLinks
    id="mobile-nav"
    class="island glass absolute top-full right-0 left-0 z-50 mt-2 hidden flex-col gap-3 px-6 py-4 md:hidden"
  />
</div>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById("theme-toggle")
    const autoIcon = toggleBtn?.querySelector(".theme-icon-auto")
    const lightIcon = toggleBtn?.querySelector(".theme-icon-light")
    const darkIcon = toggleBtn?.querySelector(".theme-icon-dark")

    function updateIcons(theme: string) {
      autoIcon?.classList.toggle("icon-swap-show", theme === "auto")
      lightIcon?.classList.toggle("icon-swap-show", theme === "light")
      darkIcon?.classList.toggle("icon-swap-show", theme === "dark")
    }

    function setTheme(theme: string) {
      const root = document.documentElement
      root.classList.add("theme-switching")
      void root.offsetWidth

      root.classList.remove("light", "dark")
      if (theme === "auto") {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        root.classList.add(prefersDark ? "dark" : "light")
        root.removeAttribute("data-theme")
        root.style.colorScheme = prefersDark ? "dark" : "light"
      } else {
        root.classList.add(theme)
        root.setAttribute("data-theme", theme)
        root.style.colorScheme = theme
      }

      void root.offsetWidth
      root.classList.remove("theme-switching")
    }

    var stored = window.localStorage.getItem("theme")
    var currentTheme =
      stored === "light" || stored === "dark" || stored === "auto" ? stored : "auto"
    updateIcons(currentTheme)

    toggleBtn?.addEventListener("click", () => {
      const nextTheme =
        currentTheme === "light" ? "dark" : currentTheme === "dark" ? "auto" : "light"
      currentTheme = nextTheme
      localStorage.setItem("theme", nextTheme)
      setTheme(nextTheme)

      updateIcons(nextTheme)
    })

    // Mobile menu logic
    const menuToggle = document.getElementById("menu-toggle")
    const mobileNav = document.getElementById("mobile-nav")
    const openIcon = menuToggle?.querySelector(".menu-icon-open")
    const closeIcon = menuToggle?.querySelector(".menu-icon-close")

    function closeMenu() {
      if (mobileNav && !mobileNav.classList.contains("hidden")) {
        mobileNav.classList.add("hidden")
        mobileNav.classList.remove("flex")
        openIcon?.classList.add("icon-swap-show")
        closeIcon?.classList.remove("icon-swap-show")
        menuToggle?.blur()
      }
    }

    menuToggle?.addEventListener("click", () => {
      const isOpen = mobileNav?.classList.contains("hidden")
      if (isOpen) {
        mobileNav?.classList.remove("hidden")
        mobileNav?.classList.add("flex")
        openIcon?.classList.remove("icon-swap-show")
        closeIcon?.classList.add("icon-swap-show")
      } else {
        closeMenu()
      }
    })

    // Close menu on click outside
    document.addEventListener("click", (event) => {
      const headerContainer = document.getElementById("header-container")
      if (headerContainer && !headerContainer.contains(event.target as Node)) {
        closeMenu()
      }
    })

    // Hide header on scroll down / Show on scroll up
    let lastScrollY = window.scrollY
    const headerContainer = document.getElementById("header-container")
    const scrollThreshold = 10 // minimum scroll delta required to trigger hide/show
    const topThreshold = 350 // do not hide header near the top of the page

    window.addEventListener(
      "scroll",
      () => {
        const currentScrollY = window.scrollY
        const diffY = currentScrollY - lastScrollY

        closeMenu()

        if (headerContainer) {
          if (currentScrollY <= topThreshold) {
            headerContainer.classList.remove("-translate-y-24")
          } else if (Math.abs(diffY) > scrollThreshold) {
            if (diffY > 0) {
              headerContainer.classList.add("-translate-y-24")
            } else {
              headerContainer.classList.remove("-translate-y-24")
            }
          }
        }

        lastScrollY = currentScrollY
      },
      { passive: true },
    )
  }

  const headerSetups = new WeakSet<HTMLElement>()

  function refreshActiveLinks() {
    const base = import.meta.env.BASE_URL
    const pathname = location.pathname.replace(base, "").replace(/\/$/, "")
    const segments = pathname.split("/").filter(Boolean)
    const hasLocale = segments.length > 0 && (segments[0] === "vi" || segments[0] === "en")
    const candidates = [
      pathname,
      `/${segments[0] || ""}${hasLocale ? `/${segments[1] || ""}` : ""}`,
    ]

    document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]").forEach((link) => {
      const href = link.getAttribute("href") ?? ""
      link.toggleAttribute("data-active", candidates.includes(href))
    })
  }

  document.addEventListener("astro:page-load", () => {
    const headerContainer = document.getElementById("header-container")
    if (!headerContainer) return

    if (headerContainer.dataset.lang !== document.documentElement.lang) {
      window.location.reload()
      return
    }

    if (!headerSetups.has(headerContainer)) {
      headerSetups.add(headerContainer)
      setupHeader()
    }

    refreshActiveLinks()
  })
</script>
