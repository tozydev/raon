---
import { ArrowLeft, House } from "@lucide/astro"
import { ROUTES } from "raon:consts"
import { getLangFromUrl, useTranslatedPath, useTranslations } from "raon:i18n"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<section class="island relative overflow-hidden p-8 text-center sm:p-16">
  <!-- Ambient Background Glow -->
  <div
    class="from-brand/15 pointer-events-none absolute -top-24 left-1/2 -z-10 size-96 -translate-x-1/2 rounded-full bg-radial to-transparent blur-3xl"
  >
  </div>

  <div class="mx-auto flex max-w-xl flex-col items-center gap-6">
    <!-- 404 Display & Heading -->
    <div class="flex flex-col items-center gap-2">
      <h1 class="font-heading text-brand text-7xl font-extrabold tracking-tight sm:text-8xl">
        404
      </h1>
      <h2 class="font-heading text-on-surface text-2xl font-bold tracking-tight sm:text-3xl">
        {t("pages.notFound.heading")}
      </h2>
    </div>

    <!-- Message -->
    <p class="text-on-surface-variant text-base leading-relaxed sm:text-lg">
      {t("pages.notFound.message")}
    </p>

    <!-- Action Buttons -->
    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
      <a href={translatePath(ROUTES.home)} class="btn btn-brand">
        <House class="size-4" />
        {t("common.actions.goHome")}
      </a>
      <button id="go-back-btn" class="btn btn-outline" type="button">
        <ArrowLeft class="size-4" />
        {t("common.actions.goBack")}
      </button>
    </div>
  </div>
</section>

<script>
  function setupGoBack() {
    const btn = document.getElementById("go-back-btn")
    btn?.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back()
      } else {
        window.location.href = "/"
      }
    })
  }

  document.addEventListener("astro:page-load", setupGoBack)
  setupGoBack()
</script>

<style>
  @keyframes spinSlow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spinSlow 20s linear infinite;
  }
</style>
