---
import type { GetStaticPaths } from "astro"
import PostCard from "raon:components/posts/PostCard.astro"
import { getPosts } from "raon:content"
import { getLangPaths, useTranslations, type HasLang } from "raon:i18n"
import Base from "raon:layouts/Base.astro"
import { getPostsJsonLd } from "raon:utils/jsonld"

interface Props extends HasLang {}

export const getStaticPaths = (() => {
  return getLangPaths("posts", "/posts")
}) satisfies GetStaticPaths

const { lang } = Astro.props
const t = useTranslations(lang)

const posts = await getPosts({ lang })

const siteUrl = (Astro.site || Astro.url.origin).toString().replace(/\/$/, "")
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()

const jsonLd = getPostsJsonLd({
  siteUrl,
  canonicalUrl,
  title: t("pages.posts.title"),
  description: t("pages.posts.description"),
  lang,
  posts,
})
---

<Base title={t("pages.posts.title")} description={t("pages.posts.description")} jsonLd={jsonLd}>
  <section class="flex flex-col gap-6">
    <div class="flex items-center gap-2 text-left">
      <h1 class="text-on-surface font-heading text-2xl font-bold">
        {t("pages.posts.list.title")}
      </h1>
    </div>

    {
      posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6">
          {posts.map((post, index) => (
            <PostCard post={post} imageLoading={index <= 5 ? "eager" : "lazy"} />
          ))}
        </div>
      ) : (
        <div class="island flex flex-col items-center justify-center gap-4 p-12 text-center">
          <p class="text-on-surface-variant">{t("pages.posts.empty")}</p>
        </div>
      )
    }
  </section>
</Base>
