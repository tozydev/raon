---
import { getEmDashCollection, getTermsForEntries } from "emdash"
import { Image } from "emdash/ui"
import { Link } from "reicon-astro"
import Base from "../../layouts/Base.astro"

const cursor = Astro.url.searchParams.get("cursor") || undefined
const {
  entries: projects,
  cacheHint,
  nextCursor,
} = await getEmDashCollection("projects", {
  orderBy: { published_at: "desc" },
  limit: 12,
  cursor,
})

if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

const labelsByEntry = await getTermsForEntries(
  "projects",
  projects.map((p) => p.data.id),
  "labels",
)

const projectsWithLabels = projects.map((project) => ({
  project,
  labels: labelsByEntry.get(project.data.id) ?? [],
}))
---

<Base
  title="Tất cả dự án"
  description="Duyệt tất cả các dự án, portfolio và sản phẩm đã thực hiện"
  type="website"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight mb-2">Tất cả dự án</h1>
      <p class="text-neutral-600 dark:text-neutral-400">
        Danh sách các dự án, sản phẩm và ứng dụng đã thực hiện.
      </p>
    </header>

    <section aria-label="Danh sách dự án">
      {projects.length === 0 ? (
        <div class="p-8 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-xl text-center">
          <h2 class="text-lg font-semibold mb-2">
            {cursor ? "Không còn dự án nào" : "Chưa có dự án"}
          </h2>
          <p class="text-neutral-500 mb-4">
            {cursor
              ? "Bạn đã đến cuối trang danh sách dự án."
              : "Các dự án được xuất bản sẽ hiển thị tại đây."}
          </p>
          {cursor && (
            <div>
              <a
                href="/projects"
                class="inline-block text-sm px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded"
              >
                Quay lại trang đầu
              </a>
            </div>
          )}
        </div>
      ) : (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            {projectsWithLabels.map(({ project, labels }) => (
              <article class="border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden flex flex-col bg-white dark:bg-neutral-900/50">
                {project.data.featured_image && (
                  <div
                    {...project.edit.featured_image}
                    class="aspect-video w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800"
                  >
                    <Image image={project.data.featured_image} class="w-full h-full object-cover" />
                  </div>
                )}

                <div class="p-4 flex-1 flex flex-col">
                  <!-- Title ngang hàng với icons demo / github -->
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <h2 class="text-base font-semibold leading-snug">
                      <a href={`/projects/${project.id}`}>
                        <span {...project.edit.title}>{project.data.title}</span>
                      </a>
                    </h2>

                    {(project.data.link || project.data.github) && (
                      <div class="flex items-center gap-1.5 shrink-0 pt-0.5">
                        {project.data.link && (
                          <a
                            href={project.data.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Xem dự án trực tuyến"
                            title="Xem dự án trực tuyến"
                            class="p-1 text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white rounded"
                          >
                            <Link size={16} />
                          </a>
                        )}
                        {project.data.github && (
                          <a
                            href={project.data.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Mã nguồn GitHub"
                            title="Mã nguồn GitHub"
                            class="p-1 text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white rounded"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="16"
                              height="16"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                            </svg>
                          </a>
                        )}
                      </div>
                    )}
                  </div>

                  <!-- Description -->
                  {project.data.description && (
                    <p
                      {...project.edit.description}
                      class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-3"
                    >
                      {project.data.description}
                    </p>
                  )}

                  <!-- Labels taxonomy (no divider) -->
                  {labels.length > 0 && (
                    <div class="mt-auto pt-2 flex flex-wrap gap-1.5">
                      {labels.map((l) => (
                        <span class="text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 font-medium">
                          {l.label}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>

          {(cursor || nextCursor) && (
            <nav aria-label="Phân trang" class="flex items-center justify-between pt-6 text-sm">
              <div>
                {cursor ? (
                  <a
                    href="/projects"
                    class="px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white"
                  >
                    ← Trang đầu
                  </a>
                ) : (
                  <span></span>
                )}
              </div>
              <div>
                {nextCursor && (
                  <a
                    href={`/projects?cursor=${encodeURIComponent(nextCursor)}`}
                    class="px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white"
                  >
                    Trang tiếp theo →
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      )}
    </section>
  </div>
</Base>
