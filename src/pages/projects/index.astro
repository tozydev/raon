---
import { getEmDashCollection, getTermsForEntries } from "emdash"
import { Image } from "emdash/ui"
import Base from "../../layouts/Base.astro"

const cursor = Astro.url.searchParams.get("cursor") || undefined
const {
  entries: posts,
  cacheHint,
  nextCursor,
} = await getEmDashCollection("projects", {
  orderBy: { published_at: "desc" },
  limit: 20,
  cursor,
})
if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
  "projects",
  posts.map((p) => p.data.id),
  "labels",
)
const postsWithTags = posts.map((post) => ({
  post,
  tags: tagsByEntry.get(post.data.id) ?? [],
}))
---

<Base title="Dự án">
  <h1>Tất cả dự án</h1>

  {postsWithTags.length === 0 ? (
    <p>Chưa có dự án.</p>
  ) : (
    <ul>
      {postsWithTags.map(({ post, tags }) => (
        <li>
          <a href={`/projects/${post.id}`}>
            {post.data.featured_image && (
              <div {...post.edit.featured_image}>
                <Image image={post.data.featured_image} />
              </div>
            )}
            <h2 {...post.edit.title}>{post.data.title}</h2>
          </a>
          {post.data.description && <p {...post.edit.description}>{post.data.description}</p>}
          {tags.length > 0 && (
            <div>
              {tags.map((t) => (
                <a href={`/tag/${t.slug}`}>{t.label}</a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  )}
  <nav aria-label="Pagination">
    {cursor && <a href="/projects">First page</a>}
    {nextCursor && <a href={`/projects?cursor=${encodeURIComponent(nextCursor)}`}>Next page</a>}
  </nav>
</Base>
