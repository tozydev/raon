---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash"
import { Image, PortableText, WidgetArea } from "emdash/ui"
import { ArrowLeft2, Link } from "reicon-astro"
import Base from "../../layouts/Base.astro"
import { resolveStarterSiteIdentity } from "../../utils/site-identity"

const slug = decodeSlug(Astro.params.slug)

if (!slug) {
  return Astro.rewrite("/404")
}

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug)

if (!project) {
  return Astro.rewrite("/404")
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

function getImageUrl(img: unknown): string | undefined {
  if (!img || typeof img !== "object") return undefined
  const image = img as Record<string, unknown>
  if (typeof image.src === "string" && image.src) {
    return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`
  }
  const meta = image.meta as Record<string, unknown> | undefined
  const storageKey =
    (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
    (typeof image.id === "string" ? image.id : undefined)
  if (storageKey) {
    return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`
  }
  return undefined
}

const featuredImageUrl = getImageUrl(project.data.featured_image)
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings())

// SEO meta
const seo = getSeoMeta(project, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
  defaultOgImage: featuredImageUrl,
})

const labels = project.data.terms?.labels ?? []
const publishedAt = project.data.publishedAt ?? null
const modifiedTime = project.data.updatedAt?.toISOString()
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description || project.data.description}
  canonical={seo.canonical}
  robots={seo.robots}
  image={seo.ogImage}
  type="website"
  publishedTime={publishedAt?.toISOString() ?? null}
  modifiedTime={modifiedTime}
  content={{ collection: "projects", id: project.data.id, slug }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <!-- Nút quay lại danh sách dự án -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white"
      >
        <ArrowLeft2 size={16} />
        <span>Tất cả dự án</span>
      </a>
    </div>

    <article class="mb-16">
      <header class="mb-10">
        <!-- Tags/Labels trên tiêu đề -->
        {labels.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-4">
            {labels.map((t) => (
              <span class="text-xs px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 font-medium">
                {t.label}
              </span>
            ))}
          </div>
        )}

        <!-- Tiêu đề dự án -->
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 leading-tight text-neutral-900 dark:text-neutral-50"
          {...project.edit.title}
        >
          {project.data.title}
        </h1>

        <!-- Mô tả ngắn dự án -->
        {project.data.description && (
          <p
            class="text-lg text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed"
            {...project.edit.description}
          >
            {project.data.description}
          </p>
        )}

        <!-- Liên kết dự án CTA (Xem trực tuyến & GitHub) -->
        {(project.data.link || project.data.github) && (
          <div class="flex items-center gap-3 mb-8">
            {project.data.link && (
              <a
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 text-xs font-medium hover:opacity-90 transition-opacity"
              >
                <Link size={14} />
                <span>Xem trực tuyến</span>
              </a>
            )}
            {project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-white text-xs font-medium hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
                <span>Mã nguồn</span>
              </a>
            )}
          </div>
        )}

        <!-- Ảnh chính dự án -->
        {project.data.featured_image && (
          <figure class="mb-8" {...project.edit.featured_image}>
            <div class="aspect-video w-full rounded-2xl overflow-hidden bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-800">
              <Image
                image={project.data.featured_image}
                class="w-full h-full object-cover block"
                priority
              />
            </div>
            {project.data.featured_image.alt && (
              <figcaption class="mt-2 text-center text-xs text-neutral-500 dark:text-neutral-400">
                {project.data.featured_image.alt}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      <!-- Nội dung chi tiết dự án -->
      {project.data.content && (
        <div class="prose dark:prose-invert max-w-none mb-12">
          <PortableText value={project.data.content} />
        </div>
      )}

      <!-- Bộ sưu tập hình ảnh dự án nếu có -->
      {project.data.gallery && project.data.gallery.length > 0 && (
        <section aria-label="Bộ sưu tập hình ảnh dự án" class="mb-12">
          <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 mb-6">
            Hình ảnh dự án
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {project.data.gallery.map(
              (item) =>
                item?.image && (
                  <div class="aspect-video rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-800">
                    <Image image={item.image} class="w-full h-full object-cover block" />
                  </div>
                ),
            )}
          </div>
        </section>
      )}
    </article>

    <!-- Sidebar Widget Area nếu có -->
    <aside class="mb-16">
      <WidgetArea name="sidebar" />
    </aside>
  </div>
</Base>
