---
import type { GetStaticPaths } from "astro"
import Hero from "raon:components/home/Hero.astro"
import RecentPosts from "raon:components/posts/RecentPosts.astro"
import FeaturedProjects from "raon:components/projects/FeaturedProjects.astro"
import { getLangPaths, useTranslations, type HasLang } from "raon:i18n"
import Base from "raon:layouts/Base.astro"
import { getHomeJsonLd } from "raon:utils/jsonld"

interface Props extends HasLang {}

export const getStaticPaths = (() => {
  return getLangPaths("index", "/")
}) satisfies GetStaticPaths

const { lang } = Astro.props
const t = useTranslations(lang)

const siteUrl = (Astro.site || Astro.url.origin).toString().replace(/\/$/, "")
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()

const jsonLd = getHomeJsonLd({
  siteUrl,
  canonicalUrl,
  title: t("pages.home.title"),
  description: t("pages.home.description"),
  lang,
})
---

<Base title={t("pages.home.title")} description={t("pages.home.description")} jsonLd={jsonLd}>
  <Hero />
  <FeaturedProjects />
  <RecentPosts />
</Base>
