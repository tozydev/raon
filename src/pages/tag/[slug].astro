---
import {
  decodeSlug,
  getEmDashCollection,
  getTaxonomyTermsWithCacheHint,
  getTermsForEntries,
} from "emdash"
import { Image } from "emdash/ui"
import Base from "../../layouts/Base.astro"
import { formatDate } from "../../utils/locale"
import { getReadingTime } from "../../utils/reading-time"

const slug = decodeSlug(Astro.params.slug)
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
  includeCounts: false,
})
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null

if (!term) {
  return Astro.rewrite("/404")
}

const cursor = Astro.url.searchParams.get("cursor") || undefined
const {
  entries: posts,
  cacheHint,
  nextCursor,
} = await getEmDashCollection("posts", {
  where: { tag: term.slug },
  orderBy: { published_at: "desc" },
  limit: 10,
  cursor,
})

if (Astro.cache?.enabled) {
  Astro.cache.set(termsResult.cacheHint)
  Astro.cache.set(cacheHint)
}

const tagsByEntry = await getTermsForEntries(
  "posts",
  posts.map((p) => p.data.id),
  "tag",
)

const filteredPosts = posts.map((post) => ({
  post,
  tags: (tagsByEntry.get(post.data.id) ?? []).filter((t) => t.slug !== term.slug),
  readingTime: getReadingTime(post.data.content),
}))
---

<Base
  title={`Bài viết thẻ "${term.label}"`}
  description={term.description || `Tất cả bài viết được gắn thẻ ${term.label}`}
  type="website"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <header class="mb-10 max-w-4xl">
      <div class="flex items-center justify-between gap-4 mb-2">
        <h1 class="text-3xl font-bold tracking-tight">#{term.label}</h1>
        <a href="/posts" class="text-sm text-neutral-600 dark:text-neutral-400 hover:underline">
          Tất cả bài viết →
        </a>
      </div>
      <p class="text-neutral-600 dark:text-neutral-400">
        {term.description ||
          `Các bài viết được gắn thẻ ${term.label}, hiển thị theo thứ tự mới nhất.`}
      </p>
    </header>

    <section aria-label="Danh sách bài viết theo thẻ" class="max-w-4xl">
      {filteredPosts.length > 0 ? (
        <>
          <div class="flex flex-col gap-8 mb-10">
            {filteredPosts.map(({ post, tags, readingTime }) => (
              <article class="flex flex-col sm:flex-row gap-6 items-start">
                {post.data.featured_image && (
                  <div
                    {...post.edit.featured_image}
                    class="w-full sm:w-56 shrink-0 aspect-video rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800"
                  >
                    <Image
                      image={post.data.featured_image}
                      class="w-full h-full object-cover block"
                    />
                  </div>
                )}

                <div class="flex-1 min-w-0">
                  <!-- Date + reading time -->
                  <div class="text-xs text-neutral-500 dark:text-neutral-400 mb-1.5 flex items-center gap-1.5">
                    {post.data.publishedAt && (
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {formatDate(post.data.publishedAt, "short")}
                      </time>
                    )}
                    {post.data.publishedAt && <span>·</span>}
                    <span>{readingTime} phút đọc</span>
                  </div>

                  <!-- Title -->
                  <h2 class="text-lg font-semibold mb-2 leading-snug">
                    <a href={`/posts/${post.id}`}>
                      <span {...post.edit.title}>{post.data.title}</span>
                    </a>
                  </h2>

                  <!-- Excerpt -->
                  {post.data.excerpt && (
                    <p
                      {...post.edit.excerpt}
                      class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-2.5"
                    >
                      {post.data.excerpt}
                    </p>
                  )}

                  <!-- Other tags (no divider) -->
                  {tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {tags.map((t) => (
                        <a
                          href={`/tag/${t.slug}`}
                          class="text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400"
                        >
                          {t.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>

          {(cursor || nextCursor) && (
            <nav aria-label="Phân trang" class="flex items-center justify-between pt-6 text-sm">
              <div>
                {cursor ? (
                  <a
                    href={`/tag/${term.slug}`}
                    class="px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded"
                  >
                    ← Trang đầu
                  </a>
                ) : (
                  <span></span>
                )}
              </div>
              <div>
                {nextCursor && (
                  <a
                    href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
                    class="px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded"
                  >
                    Trang tiếp theo →
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      ) : (
        <div class="p-8 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-xl text-center">
          <h2 class="text-lg font-semibold mb-2">
            {cursor ? "Không còn bài viết nào" : "Chưa có bài viết"}
          </h2>
          <p class="text-neutral-500 mb-4">
            {cursor
              ? "Trang này đã vượt quá bài viết cuối cùng."
              : `Chưa có bài viết nào được gắn thẻ ${term.label}.`}
          </p>
          <div>
            <a
              href={cursor ? `/tag/${term.slug}` : "/posts"}
              class="inline-block text-sm px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 rounded"
            >
              {cursor ? "Về lại trang đầu" : "Duyệt tất cả bài viết"}
            </a>
          </div>
        </div>
      )}
    </section>
  </div>
</Base>
