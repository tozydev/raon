---
import {
  getEmDashEntry,
  getEmDashCollection,
  getTermsForEntries,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash"
import { Image, PortableText, WidgetArea } from "emdash/ui"
import { ArrowLeft2, ArrowRight2 } from "reicon-astro"
import Base from "../../layouts/Base.astro"
import { resolveStarterSiteIdentity } from "../../utils/site-identity"
import { formatDate } from "../../utils/locale"
import { getReadingTime } from "../../utils/reading-time"
import { extractToc } from "../../utils/toc"

const slug = decodeSlug(Astro.params.slug)

if (!slug) {
  return Astro.rewrite("/404")
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug)

if (!post) {
  return Astro.rewrite("/404")
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

// Lấy URL featured image cho fallback OG
function getImageUrl(img: unknown): string | undefined {
  if (!img || typeof img !== "object") return undefined
  const image = img as Record<string, unknown>
  if (typeof image.src === "string" && image.src) {
    return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`
  }
  const meta = image.meta as Record<string, unknown> | undefined
  const storageKey =
    (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
    (typeof image.id === "string" ? image.id : undefined)
  if (storageKey) {
    return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`
  }
  return undefined
}

const featuredImageUrl = getImageUrl(post.data.featured_image)
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings())

const seo = getSeoMeta(post, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
  defaultOgImage: featuredImageUrl,
})

// Reading time
const readingTime = getReadingTime(post.data.content)

// Table of contents
const toc = extractToc(post.data.content)

// Taxonomy terms
const tags = post.data.terms?.tag ?? []

// Fetch posts for navigation and related posts
const { entries: allPosts, cacheHint: allPostsCacheHint } = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
  limit: 100,
})
if (Astro.cache?.enabled) Astro.cache.set(allPostsCacheHint)

const currentIndex = allPosts.findIndex((p) => p.id === post.id)
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null
const prevPost =
  currentIndex !== -1 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null

const otherPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3)

const otherTagsByEntry = await getTermsForEntries(
  "posts",
  otherPosts.map((p) => p.data.id),
  "tag",
)
const otherPostsWithData = otherPosts.map((p) => ({
  post: p,
  tags: otherTagsByEntry.get(p.data.id) ?? [],
  readingTime: getReadingTime(p.data.content),
}))

const publishedAt = post.data.publishedAt ?? null
const modifiedTime = post.data.updatedAt?.toISOString()
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description}
  canonical={seo.canonical}
  robots={seo.robots}
  image={seo.ogImage}
  type="article"
  publishedTime={publishedAt?.toISOString() ?? null}
  modifiedTime={modifiedTime}
  content={{ collection: "posts", id: post.data.id, slug }}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <!-- Nút quay lại danh sách bài viết -->
    <div class="mb-8">
      <a
        href="/posts"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white"
      >
        <ArrowLeft2 size={16} />
        <span>Tất cả bài viết</span>
      </a>
    </div>

    <article class="mb-16">
      <header class="mb-8">
        <!-- Metadata: Thời gian đăng + Thời gian đọc đưa lên trước title -->
        <div class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 mb-3">
          {publishedAt && (
            <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "long")}</time>
          )}
          {publishedAt && <span>·</span>}
          <span>{readingTime} phút đọc</span>
        </div>

        <!-- Tiêu đề bài viết -->
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 leading-tight text-neutral-900 dark:text-neutral-50"
          {...post.edit.title}
        >
          {post.data.title}
        </h1>

        <!-- Excerpt / Lead paragraph -->
        {post.data.excerpt && (
          <p
            class="text-lg text-neutral-600 dark:text-neutral-300 mb-6 leading-relaxed"
            {...post.edit.excerpt}
          >
            {post.data.excerpt}
          </p>
        )}

        <!-- Tags (trên ảnh, không nhãn) -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-6">
            {tags.map((t) => (
              <a
                href={`/tag/${t.slug}`}
                class="text-xs px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400"
              >
                #{t.label}
              </a>
            ))}
          </div>
        )}

        <!-- Featured Image -->
        {post.data.featured_image && (
          <figure class="mb-6" {...post.edit.featured_image}>
            <div class="aspect-video w-full rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-800">
              <Image
                image={post.data.featured_image}
                class="w-full h-full object-cover block"
                priority
              />
            </div>
            {post.data.featured_image.alt && (
              <figcaption class="mt-2 text-center text-xs text-neutral-500 dark:text-neutral-400">
                {post.data.featured_image.alt}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      <!-- Phần nội dung sau header: 2 cột (Content + Sidebar TOC) -->
      <div
        class:list={[
          "grid grid-cols-1 gap-12 items-start",
          toc.length > 0 && "lg:grid-cols-[1fr_260px]",
        ]}
      >
        <!-- Cột chính: Nội dung bài viết + Next/Prev -->
        <div class="min-w-0">
          <!-- Mobile TOC: hiển thị dạng collapsible trên màn hình nhỏ -->
          {toc.length > 0 && (
            <details
              class="lg:hidden mb-8 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 p-4"
              open
            >
              <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 select-none">
                Mục lục
              </summary>
              <nav aria-label="Mục lục bài viết" class="mt-3">
                <ul class="space-y-1.5 text-sm">
                  {toc.map((item) => (
                    <li
                      class:list={[
                        item.depth === 2 && "text-neutral-700 dark:text-neutral-300",
                        item.depth === 3 && "pl-4 text-xs text-neutral-600 dark:text-neutral-400",
                        item.depth >= 4 && "pl-8 text-xs text-neutral-500 dark:text-neutral-400",
                      ]}
                    >
                      <a
                        href={`#${item.slug}`}
                        class="hover:text-neutral-950 dark:hover:text-white hover:underline block py-0.5"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )}

          <!-- Nội dung chính sử dụng Tailwind Typography -->
          <div class="prose dark:prose-invert max-w-none">
            <PortableText value={post.data.content} />
          </div>

          <!-- Điều hướng bài viết (Prev / Next) -->
          {(prevPost || nextPost) && (
            <nav
              aria-label="Điều hướng bài viết"
              class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4"
            >
              {prevPost ? (
                <a
                  href={`/posts/${prevPost.id}`}
                  class="flex flex-col p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-900/50"
                >
                  <span class="inline-flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-1.5">
                    <ArrowLeft2 size={14} />
                    <span>Bài trước</span>
                  </span>
                  <span class="text-sm font-medium text-neutral-900 dark:text-neutral-100 line-clamp-2 leading-snug">
                    {prevPost.data.title}
                  </span>
                </a>
              ) : (
                <div class="hidden sm:block" />
              )}

              {nextPost ? (
                <a
                  href={`/posts/${nextPost.id}`}
                  class="flex flex-col p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-900/50 sm:items-end sm:text-right"
                >
                  <span class="inline-flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400 mb-1.5">
                    <span>Bài tiếp theo</span>
                    <ArrowRight2 size={14} />
                  </span>
                  <span class="text-sm font-medium text-neutral-900 dark:text-neutral-100 line-clamp-2 leading-snug">
                    {nextPost.data.title}
                  </span>
                </a>
              ) : (
                <div class="hidden sm:block" />
              )}
            </nav>
          )}
        </div>

        <!-- Sidebar TOC: Cố định bên phải trên desktop -->
        {toc.length > 0 && (
          <aside class="hidden lg:block w-64 shrink-0 sticky top-20 self-start">
            <div class="max-h-[calc(100vh-6rem)] overflow-y-auto no-scrollbar">
              <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-3">
                Mục lục
              </p>
              <nav aria-label="Mục lục bài viết">
                <ul class="space-y-1.5 text-sm border-l border-neutral-200 dark:border-neutral-800">
                  {toc.map((item) => (
                    <li
                      class:list={[
                        item.depth === 2 &&
                          "pl-3 text-neutral-600 dark:text-neutral-400 font-medium",
                        item.depth === 3 && "pl-6 text-xs text-neutral-500 dark:text-neutral-400",
                        item.depth >= 4 && "pl-8 text-xs text-neutral-400 dark:text-neutral-500",
                      ]}
                    >
                      <a
                        href={`#${item.slug}`}
                        class="hover:text-neutral-950 dark:hover:text-white transition-colors block py-0.5 leading-snug"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )}
      </div>
    </article>

    <!-- Sidebar Widget Area nếu có -->
    <aside class="mb-16">
      <WidgetArea name="sidebar" />
    </aside>

    <!-- Bài viết khác / liên quan (không divider, dạng grid) -->
    {otherPostsWithData.length > 0 && (
      <section aria-label="Bài viết khác" class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
            Bài viết khác
          </h2>
          <a
            href="/posts"
            class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white"
          >
            Tất cả bài viết →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherPostsWithData.map(
            ({ post: otherPost, tags: otherTags, readingTime: otherReadingTime }) => (
              <article class="border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden flex flex-col bg-white dark:bg-neutral-900/50">
                {otherPost.data.featured_image && (
                  <div
                    {...otherPost.edit.featured_image}
                    class="aspect-video w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800"
                  >
                    <Image
                      image={otherPost.data.featured_image}
                      class="w-full h-full object-cover block"
                    />
                  </div>
                )}

                <div class="p-4 flex-1 flex flex-col">
                  <div class="text-xs text-neutral-500 dark:text-neutral-400 mb-2 flex items-center gap-1.5">
                    {otherPost.data.publishedAt && (
                      <time datetime={otherPost.data.publishedAt.toISOString()}>
                        {formatDate(otherPost.data.publishedAt, "short")}
                      </time>
                    )}
                    {otherPost.data.publishedAt && <span>·</span>}
                    <span>{otherReadingTime} phút đọc</span>
                  </div>

                  <h3 class="text-base font-semibold mb-2 leading-snug">
                    <a href={`/posts/${otherPost.id}`}>
                      <span {...otherPost.edit.title}>{otherPost.data.title}</span>
                    </a>
                  </h3>

                  {otherPost.data.excerpt && (
                    <p
                      {...otherPost.edit.excerpt}
                      class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-3"
                    >
                      {otherPost.data.excerpt}
                    </p>
                  )}

                  {otherTags.length > 0 && (
                    <div class="mt-auto pt-2 flex flex-wrap gap-1.5">
                      {otherTags.map((t) => (
                        <a
                          href={`/tag/${t.slug}`}
                          class="text-xs px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400"
                        >
                          {t.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ),
          )}
        </div>
      </section>
    )}
  </div>

  <script>
    function setupHeadingIds() {
      const content = document.querySelector(".prose")
      if (!content) return

      const headings = content.querySelectorAll("h2, h3, h4")
      const slugCounts = new Map<string, number>()

      function slugify(text: string) {
        return text
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/đ/g, "d")
          .replace(/Đ/g, "D")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)+/g, "")
      }

      headings.forEach((h) => {
        const text = h.textContent?.trim() || ""
        if (!text) return
        const baseSlug = slugify(text) || "heading"
        const count = slugCounts.get(baseSlug) || 0
        slugCounts.set(baseSlug, count + 1)
        const slug = count === 0 ? baseSlug : `${baseSlug}-${count}`
        h.id = slug
        h.classList.add("scroll-mt-20")
      })
    }

    setupHeadingIds()
    document.addEventListener("astro:page-load", setupHeadingIds)
  </script>
</Base>
