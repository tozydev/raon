---
import type { GetStaticPaths } from "astro"
import NotFound from "raon:components/page/NotFound.astro"
import { getLangPaths, useTranslations, type HasLang } from "raon:i18n"
import Base from "raon:layouts/Base.astro"

interface Props extends HasLang {}

export const getStaticPaths = (() => {
  return getLangPaths("404", "/404")
}) satisfies GetStaticPaths

const { lang } = Astro.props
const t = useTranslations(lang)
---

<Base title={t("pages.notFound.title")} description={t("pages.notFound.description")}>
  <NotFound />
</Base>
