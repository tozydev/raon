{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raon",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "tozydev.id.vn",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raon-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "raon-storage",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
}
