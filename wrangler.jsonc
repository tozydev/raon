{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raon",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "tozydev.id.vn",
    },
  ],
  "cache": {
    "enabled": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.6,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
    "issues": {
      "enabled": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raon-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "raon-storage",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "raon-cache",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
}
